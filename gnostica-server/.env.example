# ==========================================
# Gnostica Server Environment Variables
# ==========================================

# Select the complete server URL configuration: development | production
APP_ENV=development

# Mobile deep link is independent of the server environment.
APP_MOBILE_OAUTH_REDIRECT_URI=gnostica://auth/callback

# Database settings
DB_URL=jdbc:postgresql://localhost:5432/gnostica-database
DB_USERNAME=postgres
DB_PASSWORD=123
COUPON_CRYPTO_MASTER_KEY=replace-with-a-long-random-secret

# Mail Configuration (Gmail)
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PayOS credentials
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
# Set true only where the public PayOS webhook URL is configured.
PAYOS_WEBHOOK_ENABLED=false

# VNPay credentials and endpoints
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_IPN_URL=
VNPAY_POLLING_INTERVAL_MS=2000
VNPAY_VERSION=2.1.0
VNPAY_EXPIRE_MINUTES=15

# Optional: PayOS Payout credentials
PAYOS_PAYOUT_CLIENT_ID=your-payout-client-id
PAYOS_PAYOUT_API_KEY=your-payout-api-key
PAYOS_PAYOUT_CHECKSUM_KEY=your-payout-checksum-key

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Bunny.net Configuration
BUNNY_STREAM_LIBRARY_ID=your-library-id
BUNNY_STREAM_API_KEY=your-api-key
BUNNY_STORAGE_ZONE_NAME=your-zone-name
BUNNY_STORAGE_API_KEY=your-api-key

# Redis Cloud Configuration
REDIS_HOST=your-redis-host
REDIS_PORT=your-redis-port
REDIS_PASSWORD=your-redis-password

# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key

# MongoDB Configuration
MONGODB_URI=mongodb+srv://your-mongodb-username:your-mongodb-password@your-cluster.mongodb.net/your-db-name?retryWrites=true&w=majority

