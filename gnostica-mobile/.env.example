# Select development (LAN API) or production (Cloudflare Tunnel).
EXPO_PUBLIC_APP_ENV=development

# Required only in development. Use the LAN IP of the computer running Spring Boot.
EXPO_PUBLIC_DEV_API_HOST=192.168.1.10

# This is a public deep-link callback, not a secret.
EXPO_PUBLIC_OAUTH_REDIRECT_URI=gnostica://auth/callback
EXPO_PUBLIC_BUNNY_LIBRARY_ID=
